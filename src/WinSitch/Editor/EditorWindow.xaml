<Window x:Class="WinSitch.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinSitch.Editor"
        Background="{DynamicResource Brush.Canvas}"
        Foreground="{DynamicResource Brush.Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MinWidth="760" MinHeight="420">
    <Window.Resources>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Fill" Value="{DynamicResource Brush.Divider}"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="BarText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ======================= TOP BAR ======================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Normal tool options bar -->
                <StackPanel x:Name="NormalBar" Orientation="Horizontal" Margin="10,0">
                    <Button x:Name="BtnNewCapture" Style="{StaticResource IconButton}" ToolTip="New Capture (region)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M7,4 L8.5,2 H11.5 L13,4 H16 A1.5,1.5 0 0 1 17.5,5.5 V14.5 A1.5,1.5 0 0 1 16,16 H4 A1.5,1.5 0 0 1 2.5,14.5 V5.5 A1.5,1.5 0 0 1 4,4 Z M10,6.8 A3.4,3.4 0 1 1 9.99,6.8"
                                  Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.6" Width="20" Height="18" Stretch="None"/>
                            <TextBlock Text="New Capture" Margin="7,0,0,0" Style="{StaticResource BarText}"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Style="{StaticResource Divider}"/>

                    <ContentControl x:Name="ToolIconHost" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.Accent}" IsTabStop="False"/>
                    <TextBlock x:Name="ToolNameLabel" Text="Arrow" Margin="6,0,0,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <Rectangle Style="{StaticResource Divider}"/>

                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Rectangle x:Name="SwatchDivider" Style="{StaticResource Divider}"/>

                    <StackPanel x:Name="WidthPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="WidthPresets" Orientation="Horizontal"/>
                        <TextBox x:Name="PxField" Style="{StaticResource Field}" Width="44" Margin="6,0,3,0"
                                 HorizontalContentAlignment="Center"/>
                        <TextBlock Text="px" Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="ArrowPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ToggleButton x:Name="ArrowTapered" Style="{StaticResource SegToggle}" ToolTip="Tapered (Skitch-style)"/>
                        <ToggleButton x:Name="ArrowFilled" Style="{StaticResource SegToggle}" ToolTip="Filled"/>
                        <ToggleButton x:Name="ArrowOpen" Style="{StaticResource SegToggle}" ToolTip="Open"/>
                        <ToggleButton x:Name="ArrowConcave" Style="{StaticResource SegToggle}" ToolTip="Concave"/>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ToggleButton x:Name="ArrowDouble" Style="{StaticResource SegToggle}" ToolTip="Double-headed"/>
                    </StackPanel>

                    <StackPanel x:Name="TextPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ComboBox x:Name="FontCombo" Width="150" Height="28" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontSizeCombo" Width="64" Height="28" Margin="6,0,0,0" IsEditable="True"/>
                        <ToggleButton x:Name="BoldToggle" Style="{StaticResource SegToggle}" Margin="6,0,0,0" ToolTip="Bold">
                            <TextBlock Text="B" FontWeight="Bold"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicToggle" Style="{StaticResource SegToggle}" ToolTip="Italic">
                            <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia"/>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="FillPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ToggleButton x:Name="OutlineToggle" Style="{StaticResource SegToggle}" ToolTip="Outline">
                            <Rectangle Width="14" Height="10" StrokeThickness="1.7"
                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FilledToggle" Style="{StaticResource SegToggle}" ToolTip="Filled">
                            <Rectangle Width="14" Height="10"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                        </ToggleButton>
                    </StackPanel>

                    <StackPanel x:Name="ObscurePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ToggleButton x:Name="ObPixelate" Style="{StaticResource SegToggle}" Content="Pixelate" Padding="8,4"/>
                        <ToggleButton x:Name="ObBlur" Style="{StaticResource SegToggle}" Content="Blur" Padding="8,4"/>
                        <ToggleButton x:Name="ObBlock" Style="{StaticResource SegToggle}" Content="Block" Padding="8,4"/>
                        <ToggleButton x:Name="ObStripes" Style="{StaticResource SegToggle}" Content="Stripes" Padding="8,4"/>
                    </StackPanel>

                    <StackPanel x:Name="StampPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <ToggleButton x:Name="StampCheck" Style="{StaticResource SegToggle}" Content="✓" FontWeight="Bold" ToolTip="Check"/>
                        <ToggleButton x:Name="StampCross" Style="{StaticResource SegToggle}" Content="✕" FontWeight="Bold" ToolTip="Cross"/>
                        <ToggleButton x:Name="StampStar" Style="{StaticResource SegToggle}" Content="★" ToolTip="Star"/>
                        <ToggleButton x:Name="StampDot" Style="{StaticResource SegToggle}" Content="●" ToolTip="Dot"/>
                        <ToggleButton x:Name="StampNumber" Style="{StaticResource SegToggle}" Content="1·2·3" Padding="8,4"
                                      ToolTip="Auto-incrementing numbers"/>
                    </StackPanel>

                    <StackPanel x:Name="StickerPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <Button x:Name="EmojiButton" Style="{StaticResource IconButton}" FontSize="16" Content="😀"
                                ToolTip="Pick emoji"/>
                        <TextBlock Text="click the image to place" Foreground="{DynamicResource Brush.TextDim}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <StackPanel x:Name="SpotlightHintPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Divider}"/>
                        <TextBlock Text="drag to spotlight — everything else dims" Foreground="{DynamicResource Brush.TextDim}"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Crop takeover bar -->
                <Grid x:Name="CropBar" Visibility="Collapsed" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"
                                        x:Name="CropIconHost" IsTabStop="False"/>
                        <TextBlock Text="Crop" Margin="6,0,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <Rectangle Style="{StaticResource Divider}"/>
                        <TextBox x:Name="CropW" Style="{StaticResource Field}" Width="58" HorizontalContentAlignment="Center"/>
                        <TextBlock Text="×" Margin="6,0" Style="{StaticResource BarText}"/>
                        <TextBox x:Name="CropH" Style="{StaticResource Field}" Width="58" HorizontalContentAlignment="Center"/>
                        <ComboBox x:Name="AspectCombo" Width="92" Height="28" Margin="10,0,0,0"/>
                        <ToggleButton x:Name="LockToggle" Style="{StaticResource SegToggle}" Margin="6,0,0,0"
                                      ToolTip="Proportional lock">
                            <Path x:Name="LockGlyph"
                                  Data="M6,9 V6.5 A4,4 0 0 1 14,6.5 M5,9 H15 V16 H5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.6" Width="20" Height="18" Stretch="None"/>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="CropCancel" Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0"/>
                        <Button x:Name="CropApply" Style="{StaticResource PrimaryButton}" Content="Apply"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ======================= BODY ======================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tool rail -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bar}"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RailPanel" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,10">
                        <Rectangle Height="1" Width="26" Fill="{DynamicResource Brush.Divider}" Margin="0,0,0,8"/>
                        <Ellipse x:Name="ColorWell" Width="18" Height="18" Cursor="Hand"
                                 Stroke="{DynamicResource Brush.Divider}" StrokeThickness="1"
                                 ToolTip="Current color — click to change"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Canvas -->
            <ScrollViewer x:Name="Scroller" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource Brush.Canvas}" Focusable="False"
                          PanningMode="Both">
                <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                    <Border BorderBrush="#33000000" BorderThickness="1">
                        <local:DocumentCanvas x:Name="Canvas"/>
                    </Border>
                    <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
                        <TextBox x:Name="EditBox" Visibility="Collapsed" MinWidth="24"
                                 Background="Transparent" BorderBrush="{DynamicResource Brush.Accent}"
                                 BorderThickness="1" Padding="0" AcceptsReturn="True"
                                 FontWeight="Bold"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ======================= BOTTOM BAR ======================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Bar}"
                BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnUndo" Style="{StaticResource IconButton}" ToolTip="Undo (Ctrl+Z)">
                        <Path Data="M8,4 L4,8 L8,12 M4,8 H12 A4,4 0 0 1 16,12 V13"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.7" Width="20" Height="17"
                              Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource IconButton}" ToolTip="Redo (Ctrl+Y)">
                        <Path Data="M12,4 L16,8 L12,12 M16,8 H8 A4,4 0 0 0 4,12 V13"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.7" Width="20" Height="17"
                              Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnTrash" Style="{StaticResource IconButton}" ToolTip="Delete selection / clear all">
                        <Path Data="M5,6 H15 M8,6 V4.5 H12 V6 M6,6 L6.8,16 H13.2 L14,6 M8.6,8.5 V13.5 M11.4,8.5 V13.5"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.6" Width="20" Height="17"
                              Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <Button x:Name="BtnZoomOut" Style="{StaticResource IconButton}" Content="−" FontSize="15" ToolTip="Zoom out"/>
                    <Button x:Name="BtnZoomLabel" Style="{StaticResource IconButton}" ToolTip="Zoom">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Margin="0,2,5,0"/>
                            <TextBlock x:Name="ZoomText" Text="100%" Style="{StaticResource BarText}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnZoomIn" Style="{StaticResource IconButton}" Content="+" FontSize="15" ToolTip="Zoom in"/>
                    <Rectangle Style="{StaticResource Divider}"/>
                    <TextBlock x:Name="SizeReadout" Style="{StaticResource BarText}"
                               Foreground="{DynamicResource Brush.TextDim}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnDragOut" Style="{StaticResource IconButton}"
                            ToolTip="Drag me into any app">
                        <Path Data="M8,11 V4.8 A1.2,1.2 0 0 1 10.4,4.8 V9.5 M10.4,9 A1.2,1.2 0 0 1 12.8,9 V10 M12.8,10 A1.2,1.2 0 0 1 15.2,10.4 V13 A4.5,4.5 0 0 1 10.7,17.5 H10 A4.6,4.6 0 0 1 6.2,15.4 L4.2,12.4 A1.3,1.3 0 0 1 6.2,10.9 L8,12.6 M2.5,6.5 H5.5 M3.4,3.4 L5.6,5.6"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.5" Width="20" Height="20"
                              Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnCopy" Style="{StaticResource IconButton}" ToolTip="Copy image (Ctrl+Shift+C)">
                        <Path Data="M7,7 H16 V17 H7 Z M7,10 H4 V3 H13 V7"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.6" Width="20" Height="19"
                              Stretch="None" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="BtnSave" Style="{StaticResource IconButton}" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10,3 V12 M6.5,8.5 L10,12 L13.5,8.5 M4,14.5 V16 H16 V14.5"
                                  Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.6" Width="20" Height="18"
                                  Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <TextBlock x:Name="FormatText" Text=".png" Margin="5,0,3,0" Style="{StaticResource BarText}"/>
                            <Path Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Brush.TextDim}" StrokeThickness="1.5"
                                  VerticalAlignment="Center" Margin="1,2,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnShare" Style="{StaticResource IconButton}" ToolTip="Share">
                        <Path Data="M10,12 V3 M6.8,5.8 L10,2.6 L13.2,5.8 M5,9 H4 V17 H16 V9 H15"
                              Stroke="{DynamicResource Brush.Glyph}" StrokeThickness="1.6" Width="20" Height="19"
                              Stretch="None" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
