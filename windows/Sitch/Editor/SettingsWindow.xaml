<Window x:Class="Sitch.Editor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sitch Settings" Width="540" Height="600"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TabButton" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="14" Padding="16,5" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <RadioButton x:Name="TabGeneral" Style="{StaticResource TabButton}" Content="General" IsChecked="True"/>
            <RadioButton x:Name="TabCapture" Style="{StaticResource TabButton}" Content="Capture"/>
            <RadioButton x:Name="TabEditor" Style="{StaticResource TabButton}" Content="Editor"/>
        </StackPanel>

        <!-- ============ General ============ -->
        <StackPanel x:Name="PageGeneral" Grid.Row="1" Margin="4,10,4,0">
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem" Content="System" GroupName="theme" Margin="0,0,18,0"/>
                <RadioButton x:Name="ThemeLight" Content="Light" GroupName="theme" Margin="0,0,18,0"/>
                <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="theme"/>
            </StackPanel>

            <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkTaskbar" Content="Show editor windows in the taskbar"/>
            <CheckBox x:Name="ChkLogin" Content="Open at login"/>
            <TextBlock Style="{StaticResource Note}"
                       Text="Sitch lives in your system tray — click the tray icon to capture, right-click for everything else."/>
        </StackPanel>

        <!-- ============ Capture ============ -->
        <StackPanel x:Name="PageCapture" Grid.Row="1" Margin="4,10,4,0" Visibility="Collapsed">
            <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Capture" VerticalAlignment="Center"/>
                <TextBox x:Name="HotkeyBox" Grid.Column="1" Style="{StaticResource Field}" IsReadOnly="True"
                         Margin="0,3" Cursor="Hand" ToolTip="Click, then press the new key combination"/>
                <TextBlock Text="Recapture last region" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="RecaptureBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                         IsReadOnly="True" Margin="0,3" Cursor="Hand"
                         ToolTip="Click, then press the new key combination"/>
                <TextBlock Text="Capture to clipboard" Grid.Row="2" VerticalAlignment="Center"/>
                <TextBox x:Name="QuickCopyBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                         IsReadOnly="True" Margin="0,3" Cursor="Hand"
                         ToolTip="Click, then press the new key combination"/>
            </Grid>
            <TextBlock Style="{StaticResource Note}"
                       Text="Click a field and press any combination (e.g. Ctrl+Alt+4 or Ctrl+Shift+PrintScreen). Esc reverts."/>

            <TextBlock Text="SAVING" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Style="{StaticResource Field}"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource GhostButton}"
                        Content="Browse…" Margin="8,0,0,0"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Default format" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="FormatCombo" Width="90" Height="28"/>
            </StackPanel>

            <TextBlock Text="AFTER CAPTURING" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkAfterShow" Content="Show the editor"/>
            <CheckBox x:Name="ChkAfterCopy" Content="Copy to clipboard"/>
            <CheckBox x:Name="ChkAfterSave" Content="Save to file"/>

            <TextBlock Text="TIMER &amp; WATCHER" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Capture timer" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="TimerCombo" Width="90" Height="28"/>
            </StackPanel>
            <CheckBox x:Name="ChkWatch" Margin="0,10,0,0"
                      Content="Open the editor after a system screenshot (Win+PrtScn)"/>
        </StackPanel>

        <!-- ============ Editor ============ -->
        <StackPanel x:Name="PageEditor" Grid.Row="1" Margin="4,10,4,0" Visibility="Collapsed">
            <TextBlock Text="TOOLS" Style="{StaticResource SectionHeader}"/>
            <CheckBox x:Name="ChkRememberTool" Content="Remember the last used tool"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Arrow width (px)" VerticalAlignment="Center"/>
                <TextBox x:Name="ArrowWidthBox" Grid.Column="1" Style="{StaticResource Field}" Margin="0,3"/>
                <TextBlock Text="Text size (pt)" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="TextSizeBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Margin="0,3"/>
            </Grid>

            <TextBlock Text="SPOTLIGHT" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="DimSlider" Width="220" Minimum="20" Maximum="90" TickFrequency="5"
                        IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="DimLabel" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Note}" Text="How much everything outside a spotlight is dimmed."/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Sitch 0.2.0" Foreground="{DynamicResource Brush.TextDim}"
                   FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
